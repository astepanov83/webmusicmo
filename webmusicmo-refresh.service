# Runs the station list refresh once. Started by webmusicmo-refresh.timer.
[Unit]
Description=webmusicmo station list refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__DIR__
# A writable path outside the repo, so the refresh never dirties the tracked seed file and
# blocks "git pull". Must stay in step with STATE_DIR in scripts/install-service.sh.
Environment=STATIONS_FILE=%h/.local/state/webmusicmo/stations.json
ExecStart=__NODE__ scripts/refresh.js
